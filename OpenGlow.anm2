--information:Open Glow r2 (物理減衰グロー)
--label:光効果
--filter
--track@strength:強さ,0,1000,100,0.1
--track@radius:拡散,4,2000,300,1
--track@falloff:減衰,0.5,4,2,0.01
--track@threshold:しきい値,0,100,0,0.1
--track@gamma_v:ガンマ,1,3,2.2,0.01
--select@blend_mode:合成モード=0,リニア加算=0,スクリーン=1,グローのみ=2
--color@tint:光色,nil
--group:アスペクト比
--track@aspect:縦横比,-10,10,0,0.01
--track@angle:角度,-360,360,0,0.01
--group:オプション,false
--check@dither:ディザ,true
--check@mono_dither:モノクロディザ,false
--check@fixsize:サイズ固定,false
--hide@fixsize:filter==1

--[[pixelshader@OG_Pre:
// 前処理: グロー空間(回転+短軸圧縮)へ変換しつつ、ガンマ補正でリニア光化、
//         しきい値カット(ソフトニー)と光色を適用。
//         予算に応じて解像度を下げる場合も、X/Y両方向のテントフィルタで縮小する。
Texture2D src : register(t0);
SamplerState smp : register(s0);
cbuffer constant0 : register(b0) {
    float th_lin, knee, gam, taps_x;
    float tint_r, tint_g, tint_b, taps_y;
    float m00, m01, m10, m11;
    float crx, cry, cgx, cgy;
    float inv_w, inv_h, pad0, pad1;
};
float4 OG_Pre(float4 pos : SV_Position) : SV_Target {
    float2 q = pos.xy - float2(cgx, cgy);
    float2 p = float2(m00 * q.x + m01 * q.y, m10 * q.x + m11 * q.y) + float2(crx, cry);
    int nx = int(taps_x + 0.5);
    int ny = int(taps_y + 0.5);
    float4 acc = 0.0;
    float wsum = 0.0;
    float2 dx = float2(m00, m10);
    float2 dy = float2(m01, m11);
    for (int j = 0; j < ny; j++) {
        float ty = ny > 1 ? 2.0 * (j + 0.5) / taps_y - 1.0 : 0.0;
        float wy = 1.0 - abs(ty);
        for (int i = 0; i < nx; i++) {
            float tx = nx > 1 ? 2.0 * (i + 0.5) / taps_x - 1.0 : 0.0;
            float wx = 1.0 - abs(tx);
            float w = wx * wy;
            float2 sp = p + tx * dx + ty * dy;
            float4 c = src.SampleLevel(smp, sp * float2(inv_w, inv_h), 0);
            acc += w * float4(pow(max(c.rgb, 0.0), gam), c.a);
            wsum += w;
        }
    }
    acc /= wsum;
    float br = max(acc.r, max(acc.g, acc.b));
    float soft = clamp(br - th_lin + knee, 0.0, 2.0 * knee);
    soft = soft * soft / (4.0 * knee + 1e-5);
    float contrib = max(soft, br - th_lin) / max(br, 1e-5);
    return float4(acc.rgb * (contrib * float3(tint_r, tint_g, tint_b)), acc.a * contrib);
}
]]

--[[pixelshader@OG_Down:
// 1/2縮小 (13タップ・Jimenezフィルタ: ちらつき防止の定番)
Texture2D src : register(t0);
SamplerState smp : register(s0);
cbuffer constant0 : register(b0) {
    float2 t;
};
float4 OG_Down(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target {
    float4 s = 0.125 * src.SampleLevel(smp, uv, 0);
    s += 0.125   * src.SampleLevel(smp, uv + t * float2(-1.0, -1.0), 0);
    s += 0.125   * src.SampleLevel(smp, uv + t * float2( 1.0, -1.0), 0);
    s += 0.125   * src.SampleLevel(smp, uv + t * float2(-1.0,  1.0), 0);
    s += 0.125   * src.SampleLevel(smp, uv + t * float2( 1.0,  1.0), 0);
    s += 0.0625  * src.SampleLevel(smp, uv + t * float2( 0.0, -2.0), 0);
    s += 0.0625  * src.SampleLevel(smp, uv + t * float2(-2.0,  0.0), 0);
    s += 0.0625  * src.SampleLevel(smp, uv + t * float2( 2.0,  0.0), 0);
    s += 0.0625  * src.SampleLevel(smp, uv + t * float2( 0.0,  2.0), 0);
    s += 0.03125 * src.SampleLevel(smp, uv + t * float2(-2.0, -2.0), 0);
    s += 0.03125 * src.SampleLevel(smp, uv + t * float2( 2.0, -2.0), 0);
    s += 0.03125 * src.SampleLevel(smp, uv + t * float2(-2.0,  2.0), 0);
    s += 0.03125 * src.SampleLevel(smp, uv + t * float2( 2.0,  2.0), 0);
    return s;
}
]]

--[[pixelshader@OG_Up:
// テント補間で拡大した下位レベルを重みwlowで現レベルに累積
Texture2D low : register(t0);
Texture2D cur : register(t1);
SamplerState smp : register(s0);
cbuffer constant0 : register(b0) {
    float2 t;
    float wlow, pad0;
};
float4 OG_Up(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target {
    float4 s = 4.0 * low.SampleLevel(smp, uv, 0);
    s += 2.0 * low.SampleLevel(smp, uv + t * float2(-1.0,  0.0), 0);
    s += 2.0 * low.SampleLevel(smp, uv + t * float2( 1.0,  0.0), 0);
    s += 2.0 * low.SampleLevel(smp, uv + t * float2( 0.0, -1.0), 0);
    s += 2.0 * low.SampleLevel(smp, uv + t * float2( 0.0,  1.0), 0);
    s += low.SampleLevel(smp, uv + t * float2(-1.0, -1.0), 0);
    s += low.SampleLevel(smp, uv + t * float2( 1.0, -1.0), 0);
    s += low.SampleLevel(smp, uv + t * float2(-1.0,  1.0), 0);
    s += low.SampleLevel(smp, uv + t * float2( 1.0,  1.0), 0);
    return cur.Load(int3(pos.xy, 0)) + wlow * (s / 16.0);
}
]]

--[[pixelshader@OG_Final:
// 合成: グロー空間から逆変換で読み出し、リニア空間で光を加算してガンマ空間へ戻す。
//       仕上げにIGNディザで量子化バンディングを防止。
Texture2D src : register(t0);
Texture2D glw : register(t1);
SamplerState smp : register(s0);
cbuffer constant0 : register(b0) {
    float amp, inv_gam, gam, mode;
    float i00, i01, i10, i11;
    float crx, cry, cgx, cgy;
    float inv_gw, inv_gh, dith, mono;
    float tox, toy, gw, gh;
};
float ign(float2 xy) {
    return frac(52.9829189 * frac(0.06711056 * xy.x + 0.00583715 * xy.y));
}
// Catmull-Romバイキュービック読み出し (9タップ最適化版)。
// 縦横比使用時はグローバッファをA倍に引き伸ばして読むため、バイリニアだと
// 折れ線状の補間ムラが縁のギザギザとして見える。C1連続な補間で滑らかにする。
// (倍率1のときは重みが単位化されバイリニアと完全一致)
float3 sample_cr(float2 uv) {
    float2 sp = uv * float2(gw, gh);
    float2 tc = floor(sp - 0.5) + 0.5;
    float2 f = sp - tc;
    float2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    float2 w3 = f * f * (0.5 * f - 0.5);
    float2 w12 = 1.0 - w0 - w3;
    float2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    float2 it = float2(inv_gw, inv_gh);
    float2 p0 = (tc - 1.0) * it;
    float2 p3 = (tc + 2.0) * it;
    float2 p12 = (tc + w2 / w12) * it;
    float3 s;
    s  = (glw.SampleLevel(smp, float2(p0.x,  p0.y ), 0).rgb * w0.x
        + glw.SampleLevel(smp, float2(p12.x, p0.y ), 0).rgb * w12.x
        + glw.SampleLevel(smp, float2(p3.x,  p0.y ), 0).rgb * w3.x) * w0.y;
    s += (glw.SampleLevel(smp, float2(p0.x,  p12.y), 0).rgb * w0.x
        + glw.SampleLevel(smp, float2(p12.x, p12.y), 0).rgb * w12.x
        + glw.SampleLevel(smp, float2(p3.x,  p12.y), 0).rgb * w3.x) * w12.y;
    s += (glw.SampleLevel(smp, float2(p0.x,  p3.y ), 0).rgb * w0.x
        + glw.SampleLevel(smp, float2(p12.x, p3.y ), 0).rgb * w12.x
        + glw.SampleLevel(smp, float2(p3.x,  p3.y ), 0).rgb * w3.x) * w3.y;
    return s;
}
float4 OG_Final(float4 pos : SV_Position) : SV_Target {
    float2 p = pos.xy - float2(crx, cry);
    float2 quv = (float2(i00 * p.x + i01 * p.y, i10 * p.x + i11 * p.y)
                  + float2(cgx, cgy)) * float2(inv_gw, inv_gh);
    float3 g_lin = max(amp * sample_cr(quv), 0.0);
    float3 g_enc = pow(g_lin, inv_gam);
    float ah = saturate(max(g_enc.r, max(g_enc.g, g_enc.b)));
    float4 c = src.Load(int3(pos.xy, 0));
    float3 rgb;
    float a_out;
    if (mode > 1.5) {                                             // グローのみ
        rgb = min(g_enc, 1.0);
        a_out = ah;
    } else {
        a_out = c.a + (1.0 - c.a) * ah;
        if (mode < 0.5) {                                         // リニア加算
            rgb = pow(pow(max(c.rgb, 0.0), gam) + g_lin, inv_gam);
        } else {                                                  // スクリーン
            rgb = c.rgb + min(g_enc, 1.0) * (1.0 - min(c.rgb, 1.0));
        }
    }
    if (dith > 0.5) {
        float2 xy = pos.xy + float2(tox, toy);
        float3 nz;
        nz.r = ign(xy);
        nz.g = mono > 0.5 ? nz.r : ign(xy + 17.83);
        nz.b = mono > 0.5 ? nz.r : ign(xy - 17.83);
        // 値が0(完全透明・完全黒)の画素は汚さない
        rgb = max(rgb + (nz - 0.5) / 255.0 * (rgb > 0.0 ? (float3)1.0 : (float3)0.0), 0.0);
        if (a_out > 0.0 && a_out < 1.0) {
            a_out = saturate(a_out + (ign(xy + float2(-31.41, 47.12)) - 0.5) / 255.0);
        }
    }
    return float4(rgb, a_out);
}
]]

local obj, math = obj, math
local budget = require("EffectUtils_Budget")

-- パラメータ正規化
local I = strength / 100
local R = math.max(radius, 4)
local gam = gamma_v
if I <= 0 or obj.w < 1 or obj.h < 1 then return end

-- 光色 (リニア空間の係数に変換)
local tr, tg, tb = 1.0, 1.0, 1.0
if tint then
    local r8, g8, b8 = RGB(tint)
    tr = (r8 / 255) ^ gam
    tg = (g8 / 255) ^ gam
    tb = (b8 / 255) ^ gam
end

-- アスペクト比: グロー空間 = 実空間を回転して長軸方向に1/Aへ圧縮した空間
--   縦横比0で円形、正で横長、負で縦長。伸長率 A = 1 + |縦横比|
--   実空間でのぼかし幅は 長軸 R*sqrt(A) / 短軸 R/sqrt(A) (幾何平均がRのまま保たれる)
local A = 1 + math.min(math.abs(aspect), 10)
local elongX = aspect >= 0
local Rg = R / math.sqrt(A)
local th = 0
if A > 1 then th = angle * math.pi / 180 end
local co, si = math.cos(th), math.sin(th)
local sx, sy = 1, 1
if A > 1 then
    if elongX then sx = A else sy = A end
end
-- M: グロー空間→実空間 (回転*拡大)、Iv: その逆
local m00, m01, m10, m11 = co * sx, -si * sy, si * sx, co * sy
local i00, i01, i10, i11 = co / sx, si / sx, -si / sy, co / sy

-- グローがはみ出す領域を確保 (フィルタオブジェクト時とサイズ固定時は拡張しない)
local maxw, maxh = obj.getinfo("image_max")
if not (obj.getinfo("filter") or fixsize) then
    local Rx, Ry = 1.25 * Rg * sx, 1.25 * Rg * sy    -- 回転軸に沿った実空間の広がり
    local ex = math.sqrt((Rx * co) ^ 2 + (Ry * si) ^ 2)
    local ey = math.sqrt((Rx * si) ^ 2 + (Ry * co) ^ 2)
    local padx = math.floor(math.max(math.min(ex, (maxw - obj.w) / 2), 0))
    local pady = math.floor(math.max(math.min(ey, (maxh - obj.h) / 2), 0))
    if padx > 0 or pady > 0 then
        obj.effect("領域拡張", "上", pady, "下", pady, "左", padx, "右", padx, "塗りつぶし", 0)
    end
end

local W, H = obj.w, obj.h

-- グロー空間バッファの元サイズ (実空間の矩形を逆変換したときの外接矩形)
local GW0 = math.min(math.max(1, math.ceil((W * math.abs(co) + H * math.abs(si)) / sx)), maxw)
local GH0 = math.min(math.max(1, math.ceil((W * math.abs(si) + H * math.abs(co)) / sy)), maxh)

-- ピラミッドの段数: 拡散半径Rgに対して log2(Rg) 段 (端数は最上段の重みで補間)
-- 重み比 q = 2^(2-p): 1オクターブごとに重みq倍 → 合成PSFの裾が r^(-p) に漸近
--   p=2 (q=1, 等重み) がちょうど逆二乗則
local p = falloff
local q = 2 ^ (2 - p)

-- 指定解像度・半径で実際に使うピラミッドの段とサイズを作る
local function make_levels(gw, gh, rg)
    local nf = math.max(math.log(rg) / math.log(2), 0.05)
    local n_full = math.min(math.floor(nf), 12)
    local frac = nf - n_full
    local requested = math.min(n_full + (frac > 0 and 1 or 0), 12)
    local lw, lh = { [0] = gw }, { [0] = gh }
    local meff = 0
    for k = 1, requested do
        if math.max(lw[k - 1], lh[k - 1]) <= 2 then break end
        lw[k] = math.max(1, math.ceil(lw[k - 1] / 2))
        lh[k] = math.max(1, math.ceil(lh[k - 1] / 2))
        meff = k
    end
    local m = math.min(requested, meff)
    local partial = frac > 0 and m == n_full + 1
    return m, lw, lh, n_full, frac, partial
end

-- cache:open_glow/* 全段の総ドット数を見積もり、Budget の目安内に内部解像度を収める。
local full_M, full_lw, full_lh = make_levels(GW0, GH0, Rg)
if full_M < 1 then return end
local full_dots = 0
for k = 0, full_M do full_dots = full_dots + full_lw[k] * full_lh[k] end
local work_scale = budget.scale(0, full_dots)
if not work_scale then
    budget.refuse("OpenGlow", W, H)
    return
end

-- 低解像度化後は、物理的なぼかし半径も同じ比率で縮める。
-- 端数丸めを含めた実サイズで再計算し、総量が予算を超えないことを確認する。
local GW, GH, M, lw, lh, n_full, frac, partial
local work_dots = 0
for attempt = 1, 8 do
    GW = math.max(1, math.ceil(GW0 * work_scale))
    GH = math.max(1, math.ceil(GH0 * work_scale))
    local scale_x, scale_y = GW / GW0, GH / GH0
    local rg_work = Rg * math.sqrt(scale_x * scale_y)
    M, lw, lh, n_full, frac, partial = make_levels(GW, GH, rg_work)
    if M < 1 then return end
    work_dots = 0
    for k = 0, M do work_dots = work_dots + lw[k] * lh[k] end
    if budget.fits(work_dots) then break end
    local correction = budget.scale(0, work_dots)
    if not correction then
        budget.refuse("OpenGlow", W, H)
        return
    end
    work_scale = work_scale * correction
end
if not budget.fits(work_dots) then
    budget.refuse("OpenGlow", W, H)
    return
end

local scale_x, scale_y = GW / GW0, GH / GH0
if scale_x < 0.999999 or scale_y < 0.999999 then
    budget.warn_once("OpenGlow", "scaled",
        "バッファ予算に合わせ、グロー内部解像度を縮小して処理します")
end

-- 低解像度バッファの1画素が元の何画素に相当するかを反映。
-- これにより変換範囲を全体に保ち、中央だけが光る症状を防ぐ。
local pm00, pm01, pm10, pm11 = m00 / scale_x, m01 / scale_y, m10 / scale_x, m11 / scale_y
local fi00, fi01, fi10, fi11 = i00 * scale_x, i01 * scale_x, i10 * scale_y, i11 * scale_y

-- 前処理のテントフィルタ。縮小時は両方向を適切にサンプリングし、通常解像度では従来の圧縮軸フィルタと一致。
local function tap_count(step)
    if step <= 1.000001 then return 1 end
    return math.min(64, 2 * math.ceil(step - 1e-6))
end
local Kx = tap_count(sx / scale_x)
local Ky = tap_count(sy / scale_y)

-- 正規化係数 (実際に使うレベルの重みの総和)
local total, coeff = 1.0, 1.0
for k = 1, M do
    coeff = coeff * q
    total = total + (partial and k == M and coeff * frac or coeff)
end

local buf = {}
for k = 0, M do buf[k] = "cache:open_glow/" .. k end

-- ディザの時間オフセット (フレーム毎にパターンをずらす)
local tox, toy = 0, 0
if dither then
    local f = obj.frame % 64
    tox, toy = f * 23.0, f * 41.0
end

-- [1] 前処理: グロー空間へ変換 + リニア化 + しきい値 + 光色 → レベル0
local t_lin = (threshold / 100) ^ gam
obj.clearbuffer(buf[0], GW, GH)
obj.pixelshader("OG_Pre", buf[0], "object", {
    t_lin, 0.5 * t_lin, gam, Kx,
    tr, tg, tb, Ky,
    pm00, pm01, pm10, pm11,
    W / 2, H / 2, GW / 2, GH / 2,
    1 / W, 1 / H, 0, 0,
}, "copy", "clip")

-- [2] ダウンサンプル・チェーン
for k = 1, M do
    obj.clearbuffer(buf[k], lw[k], lh[k])
    obj.pixelshader("OG_Down", buf[k], buf[k - 1], { 1 / lw[k - 1], 1 / lh[k - 1] }, "copy", "clip")
end

-- [3] アップサンプルしながら重み付き累積 (最深段→レベル0)
for k = M - 1, 0, -1 do
    local wl = (partial and k == M - 1) and q * frac or q
    obj.pixelshader("OG_Up", buf[k], { buf[k + 1], buf[k] },
        { 1 / lw[k + 1], 1 / lh[k + 1], wl, 0 }, "copy", "clip")
end

-- [4] 合成 (グロー空間から逆変換で読み出し)
obj.pixelshader("OG_Final", "object", { "object", buf[0] }, {
    I / total, 1 / gam, gam, blend_mode,
    fi00, fi01, fi10, fi11,
    W / 2, H / 2, GW / 2, GH / 2,
    1 / GW, 1 / GH, dither and 1 or 0, mono_dither and 1 or 0,
    tox, toy, GW, GH,
}, "copy", "clip")
